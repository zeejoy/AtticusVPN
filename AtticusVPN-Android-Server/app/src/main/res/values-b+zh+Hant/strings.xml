    <string name="port_hint">UDP 監聽連接埠，例如 51820</string>
    <string name="port_label">連接埠</string>
    <string name="port_help">連接埠範圍 1–65535，新安裝預設使用 WireGuard 常用連接埠 51820；現有設定保留原連接埠。修改後請同步用戶端與路由器的 UDP 規則。</string>
    <string name="mtu_hint">MTU（1280–1420）</string>
    <string name="dns_mode">上游 DNS 模式</string>
    <string name="mtu_label">MTU</string>
    <string name="mtu_help">通道封包大小，單位為位元組，範圍 1280–1420，預設 1380。不確定時保留預設值。</string>
