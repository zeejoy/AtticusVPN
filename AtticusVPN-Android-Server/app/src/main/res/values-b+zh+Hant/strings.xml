    <string name="ddns_section">DDNS（選用）</string>
    <string name="provider">服務供應商</string>
    <string name="ddns_hostname_label">網域名稱</string>
    <string name="ddns_hostname_help">填寫在所選服務商設定的完整網域名稱，不加 https://、路徑或連接埠。</string>
    <string name="ddns_hostname_help_duckdns">填寫已申請的 DuckDNS 網域名稱，不加 https://、路徑或連接埠；DuckDNS 可只填 subdomain。</string>
    <string name="ddns_account_label_noip">No-IP 帳號 / DDNS Key 使用者名稱</string>
    <string name="ddns_account_help_noip">填寫 No-IP 的帳號 / 可聯絡的電子郵件，或 DDNS Key 使用者名稱。密碼必須與所填帳號或 Key 配套。</string>
    <string name="ddns_account_label_dynu">Dynu 使用者名稱</string>
    <string name="ddns_account_help_dynu">填寫管理該網域名稱的 Dynu 使用者名稱。</string>
    <string name="ddns_credential_label_duckdns">DuckDNS Token</string>
    <string name="ddns_credential_help_duckdns">填寫 DuckDNS 提供的 Token。同一服務商下留空保留已儲存的值；切換服務商後需重新填寫。</string>
    <string name="ddns_credential_label_cloudflare">Cloudflare API Token</string>
    <string name="ddns_credential_help_cloudflare">填寫具有該網域名稱區域 DNS 編輯權限的 Cloudflare API Token，不是全域 API Key。同一服務商下留空保留已儲存的值；切換服務商後需重新填寫。</string>
    <string name="ddns_credential_label_noip">No-IP 帳號 / DDNS Key 密碼</string>
    <string name="ddns_credential_help_noip">填寫與上方帳號對應的 No-IP 密碼，或與 DDNS Key 使用者名稱配套的 Key 密碼。同一服務商下留空保留已儲存的值；切換服務商後需重新填寫。</string>
    <string name="ddns_credential_label_dynu">Dynu 更新密碼</string>
    <string name="ddns_credential_help_dynu">填寫用於 Dynu 動態更新的密碼。同一服務商下留空保留已儲存的值；切換服務商後需重新填寫。</string>
    <string name="ddns_credential_label_freedns">FreeDNS 記錄更新 Key</string>
    <string name="ddns_credential_help_freedns">只填寫 FreeDNS 對應記錄的更新 Key，不是完整更新 URL 或帳號密碼。同一服務商下留空保留已儲存的值；切換服務商後需重新填寫。</string>
    <string name="ddns_credential_label_custom">Token（選填）</string>
    <string name="ddns_credential_help_custom">僅當自訂 URL 使用 {token} 時填寫。同一服務商下留空保留已儲存的值；切換服務商不會沿用舊 Token。</string>
    <string name="ddns_zone_id_label">Cloudflare Zone ID</string>
    <string name="ddns_zone_id_help">填寫該網域名稱所屬 Cloudflare 區域的 Zone ID；它不是網域名稱本身。</string>
    <string name="ddns_record_id_label">Cloudflare Record ID</string>
    <string name="ddns_record_id_help">填寫準備更新的現有 AAAA 記錄 ID。應用程式只更新已有記錄，不自動建立；記錄使用僅 DNS 模式。</string>
    <string name="ddns_custom_url_label">自訂 HTTPS 更新 URL</string>
    <string name="ddns_custom_url_help">應用程式透過 HTTPS GET 請求此更新介面。URL 必須包含 {ipv6}，可選包含 {hostname} 和 {token}，應用程式會替換為目前 IPv6、上方網域名稱和 Token。請僅使用你信任的介面。</string>
