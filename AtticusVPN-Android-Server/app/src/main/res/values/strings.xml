    <string name="ddns_credential_label_duckdns">DuckDNS Token</string>
    <string name="ddns_credential_help_duckdns">填写 DuckDNS 提供的 Token。同一服务商下留空保留已保存的值；切换服务商后需重新填写。</string>
    <string name="ddns_credential_label_cloudflare">Cloudflare API Token</string>
    <string name="ddns_credential_help_cloudflare">填写具有该域名区域 DNS 编辑权限的 Cloudflare API Token，不是全局 API Key。同一服务商下留空保留已保存的值；切换服务商后需重新填写。</string>
    <string name="ddns_credential_label_noip">No-IP 账户 / DDNS Key 密码</string>
    <string name="ddns_credential_help_noip">填写与上方账户对应的 No-IP 密码，或与 DDNS Key 用户名配套的 Key 密码。同一服务商下留空保留已保存的值；切换服务商后需重新填写。</string>
    <string name="ddns_credential_label_dynu">Dynu 更新密码</string>
    <string name="ddns_credential_help_dynu">填写用于 Dynu 动态更新的密码。同一服务商下留空保留已保存的值；切换服务商后需重新填写。</string>
    <string name="ddns_credential_label_freedns">FreeDNS 记录更新 Key</string>
    <string name="ddns_credential_help_freedns">只填写 FreeDNS 对应记录的更新 Key，不是完整更新 URL 或账户密码。同一服务商下留空保留已保存的值；切换服务商后需重新填写。</string>
    <string name="ddns_credential_label_custom">Token（可选）</string>
    <string name="ddns_credential_help_custom">仅当自定义 URL 使用 {token} 时填写。同一服务商下留空保留已保存的值；切换服务商不会沿用旧 Token。</string>
    <string name="ddns_zone_id_label">Cloudflare Zone ID</string>
