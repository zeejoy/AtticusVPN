<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.AtticusServer" parent="android:style/Theme.Material.Light.NoActionBar">
        <!-- 纯平台 Theme，不依赖 AppCompat；颜色属性属于 android 命名空间。 -->
        <item name="android:colorPrimary">@color/atticus_blue</item>
        <item name="android:colorPrimaryDark">@color/atticus_navy</item>
        <item name="android:colorAccent">@color/atticus_teal</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/atticus_surface</item>
    </style>
    <style name="Widget.AtticusTerminal" parent="">
        <item name="android:scrollbars">vertical</item>
        <item name="android:scrollbarSize">3dp</item>
        <item name="android:scrollbarStyle">insideOverlay</item>
        <item name="android:fadeScrollbars">false</item>
        <item name="android:scrollbarAlwaysDrawVerticalTrack">true</item>
        <item name="android:scrollbarThumbVertical">@drawable/terminal_scroll_thumb</item>
        <item name="android:scrollbarTrackVertical">@drawable/terminal_scroll_track</item>
    </style>
</resources>
