  INTERNET 用于标准 WireGuard UDP、用户态转发和 DDNS；网络状态权限只读取连接变化。
  Foreground Service 使用 specialUse，因为这是用户明确启动且持续可见的自托管网络服务，
  不使用 dataSync 类型冒充长期 VPN 服务器。应用不备份密钥，也禁止明文 HTTP。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 仅 API 24–28 在用户主动保存公共图片时请求；API 29+ 使用 MediaStore。 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".AtticusServerApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/channel_app_name"
        android:localeConfig="@xml/locales_config"
        tools:ignore="UnusedAttribute"
        android:supportsRtl="true"
        android:theme="@style/Theme.AtticusServer"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".ui.MainActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.VpnSettingsActivity" android:exported="false" />
        <activity android:name=".ui.RuntimeLogActivity" android:exported="false" />
        <activity android:name=".ui.BackgroundAccessActivity" android:exported="false" />
        <activity android:name=".ui.SettingsActivity" android:exported="false" />
        <activity android:name=".ui.LanguageSettingsActivity" android:exported="false" />
        <activity android:name=".ui.AppearanceSettingsActivity" android:exported="false" />
        <activity android:name=".ui.DeviceCapabilitiesActivity" android:exported="false" />
        <activity android:name=".ui.PeerExportActivity" android:exported="false" />

        <!-- 服务不导出，外部应用不能伪造 start/stop/peer 操作。 -->
        <service
            android:name=".service.AtticusServerService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started self-hosted WireGuard server and network gateway" />
        </service>

        <!-- tunnel AAR 只用于 Key/KeyPair；Server 不是 VPN client，明确删除其 VpnService。 -->
        <service
            android:name="com.wireguard.android.backend.GoBackend$VpnService"
            tools:node="remove" />
    </application>
</manifest>
